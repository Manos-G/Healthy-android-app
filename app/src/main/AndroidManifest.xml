<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Health Connect reads (spec 3.2) and the two writes (spec 3.3), which
      arrive here with step 7's weight and fluid screens. Menstruation is
      declared only if the user turns that toggle on (spec 10.2). Nothing is
      declared before the step that uses it.

      INTERNET arrives in step 8 with the barcode scanner, bound to
      world.openfoodfacts.org by a network security configuration (spec 11.5).
    -->
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_OXYGEN_SATURATION" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_HYDRATION" />
    <uses-permission android:name="android.permission.health.WRITE_WEIGHT" />
    <uses-permission android:name="android.permission.health.WRITE_HYDRATION" />
    <uses-permission android:name="android.permission.health.WRITE_NUTRITION" />

    <!--
      Declared so they can be requested, but requested only when the user
      turns cycle tracking on (spec 10.2). A declared permission is not a
      granted one, and nothing here is asked for at first start.
    -->
    <uses-permission android:name="android.permission.health.READ_MENSTRUATION" />
    <uses-permission android:name="android.permission.health.WRITE_MENSTRUATION" />

    <!--
      Requested after the first saved night, not at first start (spec 14.3):
      an app that asks to notify before it has done anything for you gets
      refused, and rightly.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      The barcode scanner (spec 11). The camera is optional hardware: a device
      without one still runs everything else.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!--
      One network permission, for one host (spec 11.5). The request happens
      only after a scan that missed the local product table; every other
      function works with no network.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Lets the app check whether a Health Connect provider is installed. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>
    </queries>

    <application
        android:name=".HealthyApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Healthy">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              A shared recipe or food arriving as a link from a messenger.

              The whole item is in the fragment after the #, which a browser
              never sends to a server; nothing is fetched from healthy.app and
              the host does not have to exist. This is on the launcher activity
              only. Declaring the same filter twice is what once sent Health
              Connect to the system chooser instead of our screen.

              Not autoVerify: without a published assetlinks file Android would
              hand the link to a browser, and an unverified filter at least
              offers Healthy in the chooser.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="healthy.app" android:pathPrefix="/i" />
            </intent-filter>
        </activity>

        <!--
          Hands a QR image to the share sheet without making it readable by
          every app on the phone. Only the one cache directory is exposed.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.shared"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_paths" />
        </provider>

        <!--
          Health Connect refuses an app with no rationale screen (spec 3.2).
          It opens this from its own settings, so it must be exported and must
          be a separate activity rather than a tab inside the app.

          Exactly one activity may answer this action. Declaring it on the
          launcher activity as well made the intent resolve to the system
          chooser, so Health Connect would have shown a disambiguation dialog
          instead of the rationale.
        -->
        <activity
            android:name=".health.PermissionsRationaleActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- The pre-Android-14 route to the same screen. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".health.PermissionsRationaleActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
